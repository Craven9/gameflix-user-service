          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 401 Unauthorized', () => pm.response.to.have.status(401));",
              "pm.test('Generic message', () => pm.expect(pm.response.json().message).to.eql('Invalid email or password'));"
            ]
          }
        }
